			;;
		esac
		
		case "${_case_ssh_wrap}" in
			( with-ssh-wrap-1 )
				_common_arguments+=(
						--ssh-wrap "${_ssh_wrap_1}"
					)
				_contributing=true
			;;
			( with-ssh-wrap-1d )
				_encrypt_arguments+=(
						--ssh-wrap "${_ssh_wrap_1}"
					)
				_decrypt_arguments+=(
						--ssh-wrap "${_ssh_wrap_1}"
						--ssh-wrap "${_ssh_wrap_1}"
					)
				_contributing=true
			;;
			( with-ssh-wrap-2 )
				_encrypt_arguments+=(
						--ssh-wrap "${_ssh_wrap_1}"
						--ssh-wrap "${_ssh_wrap_2}"
					)
				_decrypt_arguments+=(
						--ssh-wrap "${_ssh_wrap_2}"
						--ssh-wrap "${_ssh_wrap_1}"
					)
				_contributing=true
			;;
			( with-ssh-wrap-2d )
				_encrypt_arguments+=(
						--ssh-wrap "${_ssh_wrap_1}"
						--ssh-wrap "${_ssh_wrap_1}"
						--ssh-wrap "${_ssh_wrap_2}"
					)
				_decrypt_arguments+=(
						--ssh-wrap "${_ssh_wrap_2}"
						--ssh-wrap "${_ssh_wrap_1}"
						--ssh-wrap "${_ssh_wrap_1}"
					)
				_contributing=true
			;;
			( without-ssh-wrap )
				_common_arguments+=(
						--without-ssh-wrap
					)
			;;
			( empty-ssh-wrap )
				_encrypt_arguments+=(
						--ssh-wrap ''
					)
				_decrypt_arguments+=(
					)
				_empty_is_missing=true
			;;
			( __* )
				continue
			;;
			( * )
				false -- '[eee16443]' "${_case_ssh_wrap}"
			;;
		esac
		
		case "${_case_deterministic}" in
			( deterministic )
				if test "${_case_tool}" != password ; then
					_encrypt_arguments+=(
							--siv true
						)
				fi
			;;
			( randomized )
				if test "${_case_tool}" != password ; then
					_encrypt_arguments+=(
							--siv false
						)
				fi
			;;
			( __* )
				continue
			;;
			( * )
				false -- '[ee232fa3]' "${_case_deterministic}"
			;;
		esac
		
		case "${_case_fingerprint}" in
			( with-fingerprint )
				if test "${_case_tool}" != password ; then
					_encrypt_arguments+=(
							--fingerprint true
						)
				else
					_encrypt_arguments+=(
							--with-fingerprint
						)
				fi
				_contributing=true
			;;
			( without-fingerprint )
				_common_arguments+=(
						--without-fingerprint
					)
			;;
			( __* )
				continue
			;;
			( * )
				false -- '[fc26fb63]' "${_case_fingerprint}"
			;;
		esac
		
		case "${_case_randomness}" in
			( with-randomness-1 )
				_encrypt_arguments+=(
						--randomness "${_randomness_1}"
					)
			;;
			( with-randomness-2 )
				_encrypt_arguments+=(
						--randomness "${_randomness_1}"
						--randomness "${_randomness_2}"
					)
			;;
			( without-randomness )
				if test "${_case_tool}" != password ; then
					_encrypt_arguments+=(
							--without-randomness
						)
				fi
			;;
			( empty-randomness )
				_encrypt_arguments+=(
						--randomness ''
					)
				_empty_is_missing=true
			;;
			( __* )
				continue
			;;
			( * )
				false -- '[bafa7ad6]' "${_case_randomness}"
			;;
		esac
		
		_identifier="${_case_tool}--${_case_send}--${_case_pin}--${_case_secret}--${_case_seed}--${_case_ballast}--${_case_ssh_wrap}--${_case_associated}--${_case_deterministic}--${_case_fingerprint}--${_case_randomness}"
		_report="${_reports}/${_identifier}.txt"
		_output="${_outputs}/tests/${_identifier}.${$}.tmp"
		
		if test -e "${_report}" ; then
			continue
		fi
		
		printf -- '\n' >&2
		printf -- '[ii]  running iteration `%s %s %s %s %s %s %s %s %s %s %s`...\n' "${_case_tool}" "${_case_send}" "${_case_pin}" "${_case_secret}" "${_case_seed}" "${_case_ballast}" "${_case_ssh_wrap}" "${_case_associated}" "${_case_deterministic}" "${_case_fingerprint}" "${_case_randomness}" >&2
		
		if test "${_contributing}" == false ; then
			printf -- '[ii]    ->  non-contributing inputs;  skipping!\n' >&2
			continue
		fi
		
		if test "${#_encrypt_arguments[@]}" -eq 0 ; then
			printf -- '[ii]    ->  empty arguments;  skipping!\n' >&2
			continue
		fi
		if test "${#_decrypt_arguments[@]}" -eq 0 ; then
			printf -- '[ii]    ->  empty arguments;  skipping!\n' >&2
			continue
		fi
		
		_common_arguments+=(
				--empty-is-missing "${_empty_is_missing}"
			)
		
		TIMEFORMAT="[ii]    -> CPU (u/s/w):  %3lU %3lS %3lR;"
		
		export -- SSH_AUTH_SOCK="${__OUTPUTS}/tests/ssh-agent.sock"
		
		printf -- \
				'>>  [test]  %s %s %s %s %s %s %s %s %s %s %s %s\n' \
				"${_case_tool}" \
				"${_case_deterministic}" \
				"${_case_fingerprint}" \
				"${_case_namespace}" \
				"${_case_secret}" \
				"${_case_ssh_wrap}" \
				"${_case_pin}" \
				"${_case_seed}" \
				"${_case_ballast}" \
				"${_case_associated}" \
				"${_case_send}" \
				"${_case_randomness}" \
			> "${_output}" \
		#
		printf -- '\n\n\n\n' >> "${_output}"
		
		case "${_case_tool}" in
			
			( password )
				
				_encrypt_command=(
						password
							"${_encrypt_arguments[@]}"
							"${_common_arguments[@]}"
							--input-stdin
					)
				_decrypt_command=(
						password
							"${_decrypt_arguments[@]}"
							"${_common_arguments[@]}"
							--input-stdin
					)
				
				printf -- '>>  %q' z-tokens >> "${_output}"
				printf -- ' %q' "${_encrypt_command[@]}" >> "${_output}"
				printf -- '\n\n' >> "${_output}"
				
				printf -- '[xx]    >> %s\n' "${_encrypt_command[*]@Q}" >&2
				
				time \
				"${__OUTPUTS}/binaries/zt-exchange--release--linux--native" "${_encrypt_command[@]}" \
					< "${_file}" \
					>> "${_output}" \
					2>&1 \
				#
				
				printf -- '\n\n' >> "${_output}"
				
				if test "${_case_fingerprint}" == with-fingerprint ; then
					_output_fingerprint="$( exec -- grep -E -e '^ztxfp1[a-z0-9A-Z]+$' < "${_output}" )"
					_decrypt_command+=(
							--fingerprint "${_output_fingerprint}"
						)
				fi
				
				printf -- '>>  %q' z-tokens >> "${_output}"
				printf -- ' %q' "${_decrypt_command[@]}" >> "${_output}"
				printf -- '\n\n\n\n' >> "${_output}"
				
				printf -- '[xx]    >> %s\n' "${_decrypt_command[*]@Q}" >&2
				
				"${__OUTPUTS}/binaries/zt-exchange--release--linux--native" "${_decrypt_command[@]}" \
					< "${_file}" \
				| md5sum -b -- /dev/fd/5 \
					5<&0 \
				| md5sum -c --quiet \
					5< <( exec -- grep -v -E -e '^>>  ' -e '^## fingerprint$' -e '^ztxfp1[a-z0-9A-Z]+$' -e '^$' < "${_output}" ) \
				#
			;;
			
			( encrypt )
				
				_encrypt_command=(
						encrypt
							"${_encrypt_arguments[@]}"
							"${_common_arguments[@]}"
					)
				_decrypt_command=(
						decrypt
							"${_decrypt_arguments[@]}"
							"${_common_arguments[@]}"
					)
				
				printf -- '>>  %q' z-tokens >> "${_output}"
				printf -- ' %q' "${_encrypt_command[@]}" >> "${_output}"
				printf -- '\n\n' >> "${_output}"
				
				printf -- '[xx]    >> %s\n' "${_encrypt_command[*]@Q}" >&2
				
				time \
				"${__OUTPUTS}/binaries/zt-exchange--release--linux--native" "${_encrypt_command[@]}" \
					< "${_file}" \
					>> "${_output}" \
					2>&1 \
				#
				
				printf -- '\n\n\n\n' >> "${_output}"
				
				if test "${_case_fingerprint}" == with-fingerprint ; then
					_output_fingerprint="$( exec -- grep -E -e '^ztxfp1[a-z0-9A-Z]+$' < "${_output}" )"
					_decrypt_command+=(
							--fingerprint "${_output_fingerprint}"
						)
				fi
				
				printf -- '>>  %q' z-tokens >> "${_output}"
				printf -- ' %q' "${_decrypt_command[@]}" >> "${_output}"
				printf -- '\n\n' >> "${_output}"
				
				printf -- '[xx]    >> %s\n' "${_decrypt_command[*]@Q}" >&2
				
				"${__OUTPUTS}/binaries/zt-exchange--release--linux--native" "${_decrypt_command[@]}" \
					< <( exec -- grep -v -E -e '^>>  ' -e '^## fingerprint$' -e '^ztxfp1[a-z0-9A-Z]+$' < "${_output}" ) \
				| md5sum -b -- /dev/fd/5 \
					5<&0 \
				| md5sum -c --quiet \
					5< "${_file}" \
				#
			;;
			
			( * )
				false -- '[12356273]' "${_case_tool}"
			;;
		esac
		
		mv -T -- "${_output}" "${_report}"
		
		printf -- '\n' >&2
		
	done
!!








