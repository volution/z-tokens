					)
				_decrypt_arguments+=(
						--seed "${_seed_2}"
						--seed "${_seed_1}"
						--seed "${_seed_1}"
					)
				_contributing=true
			;;
			( without-seed )
				_common_arguments+=(
						--without-seed
					)
			;;
			( empty-seed )
				_encrypt_arguments+=(
						--seed ''
					)
				_decrypt_arguments+=(
					)
				_empty_is_missing=true
			;;
			( __* )
				continue
			;;
			( * )
				false -- '[7de1942b]' "${_case_seed}"
			;;
		esac
		
		case "${_case_ballast}" in
			( with-ballast-1 )
				_common_arguments+=(
						--ballast "${_ballast_1}"
					)
				_contributing=true
			;;
			( with-ballast-1d )
				_encrypt_arguments+=(
						--ballast "${_ballast_1}"
					)
				_decrypt_arguments+=(
						--ballast "${_ballast_1}"
						--ballast "${_ballast_1}"
					)
				_contributing=true
			;;
			( with-ballast-2 )
				_encrypt_arguments+=(
						--ballast "${_ballast_1}"
						--ballast "${_ballast_2}"
					)
				_decrypt_arguments+=(
						--ballast "${_ballast_2}"
						--ballast "${_ballast_1}"
					)
				_contributing=true
			;;
			( with-ballast-2d )
				_encrypt_arguments+=(
						--ballast "${_ballast_1}"
						--ballast "${_ballast_1}"
