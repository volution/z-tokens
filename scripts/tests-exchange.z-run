	_hyperfine_arguments+=( --command-name "ssh-wrap:1x100" )
	_hyperfine_commands+=( "${_command_base[*]@Q} --ssh-wrap ${_ssh_wrap_1@Q} --derivation-loops 100" )
	
	_hyperfine_arguments+=( --command-name "ssh-wrap:2x100" )
	_hyperfine_commands+=( "${_command_base[*]@Q} --ssh-wrap ${_ssh_wrap_1@Q} --ssh-wrap ${_ssh_wrap_2@Q} --derivation-loops 100" )
	
	_hyperfine_arguments+=( --command-name "pin:1x1" )
	_hyperfine_commands+=( "${_command_base[*]@Q} --pin ${_pin_1@Q} --derivation-loops 1" )
	
	_hyperfine_arguments+=( --command-name "pin:1x100" )
	_hyperfine_commands+=( "${_command_base[*]@Q} --pin ${_pin_1@Q} --derivation-loops 100" )
	
	_hyperfine_arguments+=( --command-name "pin:2x100" )
	_hyperfine_commands+=( "${_command_base[*]@Q} --pin ${_pin_1@Q} --pin ${_pin_2@Q} --derivation-loops 100" )
	
	_hyperfine_arguments+=( --command-name "pin:3x100" )
	_hyperfine_commands+=( "${_command_base[*]@Q} --pin ${_pin_1@Q} --pin ${_pin_2@Q} --pin ${_pin_3@Q} --derivation-loops 100" )
	
