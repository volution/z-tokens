	_secret_2='ztxcs1zw32errd0vu44rvt2h6vnmfecjtp20aacyzpxcyg9dq3szerw0sswvu32a'
	_secret_3='ztxcs1lzq6pp0xx20apeyjl6rxxu3fxzg92uwnpa2x7zwxhaau63xz062qsrlr88'
	
	_seed_1='ztxsd1lf6056vl0zl9xk2j5asj7336sskhyqmevsc32t2ct6def5mnwmcqe9kcmx'
	_seed_2='ztxsd1ggthngksghaqtnqegmdkn5jv53fw5ptv8wswa08ws7r2w9vs03js74k5ga'
	_seed_3='ztxsd1yvxe45zfwn8n6quud6hn88u700sr04ya07qldglsn3x5gg45nslq9wzgwv'
	
	_ballast_1='ztxbl1ah428t6ux086pfdgv5d5z8fle06rll5azaglg8gcnvd65mup65qqckq348'
	_ballast_2='ztxbl1y00yn7a4jjqeyxke8u6hfqks7fhjadtamny4mmp6nc43qa9ra3mqu4swle'
	_ballast_3='ztxbl1k56j57c4s3tj8ccrcrjg0l3eecjqwy3nnatjnnzh5lnapykvzanszfg4e0'
	_ballast_4='ztxbl1uqsdymrpckfv9d6dfw80tk4jxn26ntaxdjd7xtma7tkygf9c9ffswwvn5c'
	
	_ssh_wrap_1='ztxoh199xqjeytqlnqtgpsxe4m78m3tuzn92e9yh4749dnr79xt3ylg3hsa5cpk7'
	_ssh_wrap_2='ztxoh1sdr6lc4380ml33hvl0pnln7ag27qt5g26rz9lakcgm70xthxulvqvms7cy'
	
	_x25519_1_sender_private='ztxsk1szluhkftlf5zee8wfd6v43el6qa9c7f74sn3xaxjrxzh84q7436qhmh920'
	_x25519_2_sender_private='ztxsk1jz7yrht80clxjz85puk9gegnq2y9zhcnww9z8kqx2zml707rcfssgqppwg'
	
	_x25519_1_recipient_public='ztxrp17qqdhxkytsfp0ugz0h3zxuy4l2hhszxpaqt9cmqndjg8qllxfamszurtah'
	_x25519_2_recipient_public='ztxrp1fpay0z3f2sdyrj8c57yvfde9v3lf8pgj6532shuks26hstncng2qmy2dny'
	
	_hyperfine_arguments=(
			--warmup 0
			--min-runs 1
			--max-runs 10000
			--shell none
			--sort command
		##	--show-output
		)
	_hyperfine_commands=()
	
	_command_base=(
			"${__OUTPUTS}/binaries/zt-exchange--release--linux--native"
				password
		)
	
	# _hyperfine_arguments+=( --command-name "version" )
	# _hyperfine_commands+=( "${_command_base[*]@Q} --help" )
	
	_hyperfine_arguments+=( --command-name "associated:1x100k" )
	_hyperfine_commands+=( "${_command_base[*]@Q} --associated NA --derivation-loops 100000" )
	
	_hyperfine_arguments+=( --command-name "associated:2x100k" )
	_hyperfine_commands+=( "${_command_base[*]@Q} --associated NA --associated NA --derivation-loops 100000" )
	
	_hyperfine_arguments+=( --command-name "associated:3x100k" )
	_hyperfine_commands+=( "${_command_base[*]@Q} --associated NA --associated NA --associated NA --derivation-loops 100000" )
	
	_hyperfine_arguments+=( --command-name "seed:1x100k" )
	_hyperfine_commands+=( "${_command_base[*]@Q} --seed ${_seed_1@Q} --derivation-loops 100000" )
	
	_hyperfine_arguments+=( --command-name "seed:2x100k" )
	_hyperfine_commands+=( "${_command_base[*]@Q} --seed ${_seed_1@Q} --seed ${_seed_2@Q} --derivation-loops 100000" )
	
	_hyperfine_arguments+=( --command-name "seed:3x100k" )
	_hyperfine_commands+=( "${_command_base[*]@Q} --seed ${_seed_1@Q} --seed ${_seed_2@Q} --seed ${_seed_3@Q} --derivation-loops 100000" )
	
