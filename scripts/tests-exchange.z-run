					)
				_decrypt_arguments+=(
					)
				_empty_is_missing=true
			;;
			( __* )
				continue
			;;
			( * )
				false -- '[ca46feb8]' "${_case_pin}"
			;;
		esac
		
		case "${_case_secret}" in
			( with-secret-1 )
				_common_arguments+=(
						--secret "${_secret_1}"
					)
				_contributing=true
			;;
