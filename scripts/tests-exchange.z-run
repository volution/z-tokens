				_encrypt_arguments+=(
						--associated ''
					)
				_decrypt_arguments+=(
					)
				_empty_is_missing=true
			;;
			( __* )
				continue
			;;
			( * )
				false -- '[78bbf839]' "${_case_associated}"
			;;
		esac
		
		case "${_case_pin}" in
			( with-pin-1 )
				_common_arguments+=(
						--pin "${_pin_1}"
					)
				_contributing=true
			;;
			( with-pin-1d )
				_encrypt_arguments+=(
						--pin "${_pin_1}"
					)
				_decrypt_arguments+=(
						--pin "${_pin_1}"
						--pin "${_pin_1}"
					)
				_contributing=true
			;;
			( with-pin-2 )
				_encrypt_arguments+=(
