	Ar15Awk1mR146v63V6N6AAAAKnotdG9rZW5zIGV4Y2hhbmdlIHNzaCB3cmFwIGtleSBmb3
	IgdGVzdGluZwECAw==
	-----END OPENSSH PRIVATE KEY-----
	EOS
!!


<< tests / quick / exchange / ssh / agent
	test "${#}" -eq 0
	
	export -- SSH_DTACH_SOCK="${__OUTPUTS}/tests/ssh-agent-dtach.sock"
	export -- SSH_AUTH_SOCK="${__OUTPUTS}/tests/ssh-agent.sock"
	
	exec -- \
		dtach -A "${SSH_DTACH_SOCK}" \
	ssh-agent \
			-s \
			-d \
			-a "${SSH_AUTH_SOCK}" \
	#
!!


<< tests / quick / exchange / ssh / agent & load
	test "${#}" -eq 0
	
	(
		exec < /dev/null > /dev/null 2> /dev/null
		sleep -- 1s
		"${ZRUN}" ':: tests / quick / exchange / ssh / load / testing-1'
		"${ZRUN}" ':: tests / quick / exchange / ssh / load / testing-2'
	) &
	
	exec -- "${ZRUN}" ':: tests / quick / exchange / ssh / agent'
!!








