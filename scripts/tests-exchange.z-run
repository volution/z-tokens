#!/dev/null








<< tests / quick / exchange / run / debug
	"${ZRUN}" ':: cargo / debug / build & collect' zt-exchange < /dev/null > /dev/null
	export -- RUST_BACKTRACE=1
	
	TIMEFORMAT='[ii]    -> CPU (u/s/w):  %3lU %3lS %3lR;'
	
	export -- SSH_AUTH_SOCK="${__OUTPUTS}/tests/ssh-agent.sock"
	
	time \
	"${__OUTPUTS}/binaries/zt-exchange--debug--linux--native" "${@}" \
	#
!!


