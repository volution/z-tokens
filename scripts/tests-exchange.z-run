<< tests / quick / exchange / ssh / generate
	test "${#}" -eq 0
	
	_path="${__OUTPUTS}/ssh-keygen.${$}.${SRANDOM}"
	
	ssh-keygen \
			-q \
			-t ed25519 \
			-C 'z-tokens exchange ssh wrap key for testing' \
			-N '' \
			-f "${_path}" \
	#
	
	printf -- '## key fingerprint\n'
	ssh-keygen \
			-l \
			-E SHA256 \
			-f "${_path}.pub" \
	#
	printf -- '\n'
	
	printf -- '## public key\n'
	cat -- "${_path}.pub"
	printf -- '\n'
	
	printf -- '## private key\n'
	cat -- "${_path}"
	printf -- '\n'
	
	rm -- "${_path}" "${_path}.pub"
!!


